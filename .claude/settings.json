{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/doctor.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-dic.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-shell.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/lint.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/ssp-log.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/doctor.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-dic.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-shell.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/lint.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/ssp-log.ps1*)",
      "WebFetch(domain:ssp.shillest.net)",
      "WebFetch(domain:emily.shillest.net)",
      "WebFetch(domain:ukagakadreamteam.github.io)",
      "mcp__ukagaka-doc__search_docs",
      "mcp__ukagaka-doc__get_doc",
      "mcp__ukagaka-doc__list_categories"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/tools/hooks/session-start.ps1"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/tools/hooks/post-edit.ps1"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
